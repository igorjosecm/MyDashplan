{
  "name": "mydashplan",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Planejador financeiro pessoal — Demo Fase 1 (Meu Futuro, Patrimônio e Fechamento do Mês)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "npm run db:migrate:local && wrangler d1 execute DB --local --file=./migrations/seed_demo.sql",
    "db:reset:local": "node ./scripts/db-reset-local.mjs",
    "seed:generate": "node ./scripts/generate-seed.ts",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "echarts": "^6.1.0",
    "hono": "^4.13.21",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.167.0"
  },
  "allowScripts": {
    "workerd@1.20261117.1": true,
    "workerd@1.20261123.1": true,
    "esbuild@0.28.2": true
  }
}
